# =========================================================================
# Gitignore for Disaster Rescue System (Spring Boot + Thymeleaf)
# =========================================================================

# Java & Compiled Class Files
*.class
*.log
*.ctxt
.mtj.tmp/

# Package Files (JAR, WAR, ZIP)
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual Machine crash logs
hs_err_pid*
replay_pid*

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# IDE - IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

# IDE - Eclipse
bin/
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# IDE - VS Code & NetBeans
.vscode/
.nb-gradle/
nbproject/
build/
nbbuild/
dist/

# OS Specific
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Environment variables, credentials & local profiles
.env
.env.*
application-local.properties
application-local.yml
application-secret.*
!application-secret.example.*

# Heavy binary documentation files (uncomment if you want to push docx)
*.docx
*.pdf

# Temporary & cache files
*.tmp
*.bak
*.swp
